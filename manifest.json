{
  "manifest_version": 3,
  "name": "Tab Audio Capture",
  "version": "1.0.0",
  "description": "Capture audio from the active browser tab and save as WAV.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "downloads",
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/mic-16.png",
      "48": "icons/mic-48.png",
      "128": "icons/mic-128.png"
    }
  },
  "icons": {
    "16": "icons/mic-16.png",
    "48": "icons/mic-48.png",
    "128": "icons/mic-128.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
